---
interface Props {}
import { routeContext } from "../../../routing";
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VideoLink from '../../../components/VideoLink.astro';
import { workCatalogues, externalWorkVideos, externalVideoCovers } from '../../../work-resources';
import { isLanguage, languages } from '../../../i18n';
import imageSizes from '../../../work-image-sizes.json';
import { works } from '../../../works-content';
import { workCovers } from '../../../work-covers';
import workTexts from '../../../work-texts.json';

export function getStaticPaths() {
  return languages.flatMap((lang) => works.map((work) => ({ params: { lang, slug: work.slug } })));
}

const { lang: langParam, suffix } = routeContext(Astro.url.pathname);
const slug = suffix.split('/')[1];
const lang = isLanguage(langParam) ? langParam : 'es';
const work = works.find((item) => item.slug === slug);

if (!work) {
  throw new Error(`Work not found: ${slug}`);
}

const base = import.meta.env.BASE_URL;
const dimensions: Record<string, number[]> = imageSizes;
const slides = (work.gallery ?? [
  ...work.images.map(src => ({ type: 'image' as const, src })),
  ...(work.videos ?? []).map(video => ({ type: 'video' as const, src: video.src })),
]).map(item => {
  if (item.type === 'image') return { type: 'image' as const, src: item.src, width: dimensions[item.src][0], height: dimensions[item.src][1] };
  const video = work.videos?.find(video => video.src === item.src);
  if (!video) throw new Error(`Missing gallery video: ${item.src}`);
  return { ...video, type: 'video' as const };
});
const text = (workTexts as Record<string, Record<string, { html: string; text: string; links: { url: string; kind: string }[] }>>)[work.slug][lang];
const catalogue = workCatalogues[work.slug];
const videoLinks = externalWorkVideos[work.slug] ?? text.links.filter(link => link.kind === 'video').map(link => ({
  url: link.url,
  image: externalVideoCovers[work.slug] ?? workCovers[work.slug],
  description: { es: `Video de ${work.title.es}`, en: `${work.title.en} video` },
}));
const websiteLinks = text.links.filter(link => link.kind !== 'video');
---

<BaseLayout lang={lang} title={`${work.title[lang]} — Elia Gasparolo`}
  description={`${work.title[lang]} — Elia Gasparolo. ${text.text.replace(/\s+/g, ' ').slice(0, 145)}…`}
  image={`${base}${workCovers[work.slug]}`} artwork={{ name: work.title[lang], images: work.images.map(image => `${base}${image}`) }}>
  <article class="work-page">
    <div class="work-stage">
    <div class="work-heading">
      <h1 class="section-title">{work.title[lang]}</h1>

    </div>

    <div class="gallery">
    <div class="work-slider" id="work-gallery" tabindex="0" role="region" aria-label={work.title[lang]}>
      {slides.map((slide, index) => (
        <figure style={`aspect-ratio: ${slide.width} / ${slide.height}`}>
          {slide.type === 'image'
            ? <img width={slide.width} height={slide.height} src={`${base}${slide.src}`} alt={`${work.title[lang]} — ${index + 1}`} loading={index > 1 ? 'lazy' : 'eager'} />
            : <video width={slide.width} height={slide.height} autoplay muted loop playsinline preload="none" data-src={`${base}${slide.src}`} poster={`${base}${slide.poster}`} aria-label={slide.title[lang]}>
                <a href={`${base}${slide.src}`}>{lang === 'es' ? 'Ver video' : 'Watch video'}: {slide.title[lang]}</a>
              </video>}
        </figure>
      ))}
    </div>

    <div class="gallery-controls">
      <button type="button" data-gallery-prev aria-controls="work-gallery" aria-label={lang === 'es' ? 'Imagen anterior' : 'Previous image'}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M21 5 10 16l11 11" /></svg></button>
      <button type="button" data-gallery-next aria-controls="work-gallery" aria-label={lang === 'es' ? 'Imagen siguiente' : 'Next image'}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="m11 5 11 11-11 11" /></svg></button>
    </div>
    </div>
    </div>
    <div class="work-text">
      {catalogue && <a class="catalogue-link" href={`${base}${catalogue}`} download>
        <img src={`${base}icons/pdf.png`} width="512" height="512" alt="" />
        <span>{lang === 'es' ? 'Descargar Catálogo de Tránsitos' : 'Download Transits Catalogue'}</span>
      </a>}

      <div class="formatted-text" set:html={text.html.replaceAll('__BASE_URL__', base)} />
      {(videoLinks.length > 0 || websiteLinks.length > 0) && <div class:list={{ "work-links": true, "paired-videos": videoLinks.length > 1 }}>
        {videoLinks.map(link => <VideoLink labelPosition={work.slug === 'ofrendas' ? 'above' : 'beside'} href={link.url} image={`${base}${link.image}`} width={dimensions[link.image][0]} height={dimensions[link.image][1]} description={link.description[lang]} />)}
        {websiteLinks.map(link => <a class="resource-link" href={link.url} target="_blank" rel="noopener noreferrer">{lang === 'es' ? 'Ver sitio web' : 'Visit website'}</a>)}
      </div>}

    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.work-page .gallery').forEach(gallery => {
    const track = gallery.querySelector<HTMLElement>('.work-slider')!;
    const figures = Array.from(track.querySelectorAll<HTMLElement>('figure'));
    const previous = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]')!;
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const update = () => {
      const end = Math.max(0, track.scrollWidth - track.clientWidth);
      previous.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= end - 1;
    };
    const move = (direction: number) => {
      const end = Math.max(0, track.scrollWidth - track.clientWidth);
      const position = track.scrollLeft;
      const stops = [...new Set([0, ...figures.map(figure => Math.min(figure.offsetLeft, end)), end])].sort((a, b) => a - b);
      const destination = direction > 0
        ? stops.find(stop => stop > position + 1) ?? end
        : stops.findLast(stop => stop < position - 1) ?? 0;
      // Pan across wide photographs instead of jumping past unseen areas.
      const distance = Math.min(Math.abs(destination - position), track.clientWidth);
      track.scrollTo({ left: position + direction * distance, behavior: reduced.matches ? 'instant' : 'smooth' });
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('keydown', event => { if (event.target instanceof HTMLVideoElement) return; if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1); } });
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    track.querySelectorAll('img').forEach(image => image.addEventListener('load', update));
    const videos = Array.from(track.querySelectorAll('video'));
    const updateVideo = (video: HTMLVideoElement) => {
      if (video.dataset.visible === 'true' && !document.hidden) {
        if (!video.hasAttribute('src')) {
          video.src = video.dataset.src!;
          video.load();
        }
        video.muted = true;
        void video.play().catch(() => { /* Keep the poster if autoplay is unavailable. */ });
      } else video.pause();
    };
    const visibility = new IntersectionObserver(entries => entries.forEach(entry => {
      const video = entry.target as HTMLVideoElement;
      video.dataset.visible = String(entry.isIntersecting);
      updateVideo(video);
    }), { threshold: .01 });
    videos.forEach(video => visibility.observe(video));
    document.addEventListener('visibilitychange', () => videos.forEach(updateVideo));
    update();
  });
</script>
<style>
  .work-stage { height: calc(100svh - var(--content-header-height)); display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .section-title { font-size: var(--section-title-size); padding: 1.25rem 3cqw 0; }
  :global([data-variant="2"]) .work-text { margin-inline: 0; }
  :global([data-variant="2"]) .work-stage { height: calc(100svh - var(--content-header-height) - var(--content-top-space)); }
  :global([data-variant="2"]) .section-title { padding: 0; }
  .gallery { position: relative; min-height: 0; min-width: 0; }
  .work-slider { display: flex; height: 100%; gap: var(--work-slide-gap); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x proximity; position: relative; scrollbar-width: none; }
  .work-slider::-webkit-scrollbar { display: none; }
  figure { flex: 0 0 auto; height: 100%; width: auto; min-width: 0; margin: 0; scroll-snap-align: start; }
  figure img { display: block; height: 100%; width: 100%; max-width: none; }
  figure video { display: block; height: 100%; width: 100%; object-fit: contain; background: #000; }
  .gallery-controls { position: absolute; inset: 0; pointer-events: none; }
  button { background: transparent; border: 0; color: white; cursor: pointer; height: 44px; width: 44px; padding: 9.2px; position: absolute; top: 50%; transform: translateY(-50%); pointer-events: auto; filter: drop-shadow(0 1px 2px #000a); }
  [data-gallery-prev] { left: 1cqw; }
  [data-gallery-next] { right: 1cqw; }
  button svg { display: block; width: 25.6px; height: 25.6px; fill: none; stroke: currentColor; stroke-width: 1; }
  button:disabled { visibility: hidden; }
  button:hover svg { opacity: .65; }
  .work-text { font-size: .9rem; line-height: 1.75; margin: 3rem 3cqw 5rem; max-width: 44rem; }
  .formatted-text { line-height: 1.3; }
  .formatted-text :global(p) { margin: 0; min-height: 0; white-space: normal; overflow-wrap: anywhere; tab-size: 4; }
  .formatted-text :global(.paragraph-gap) { margin-top: 1.15rem; }
  .formatted-text :global(.section-gap) { margin-top: 2.3rem; }
  .formatted-text :global(.inline-artwork) { margin: 2rem 0; width: 100%; height: auto; }
  .formatted-text :global(.inline-artwork img) { display: block; width: 100%; height: auto; }
  .formatted-text :global(strong) { font-weight: 700; }
  .work-links { display: grid; justify-items: start; gap: 2rem; margin-top: 4rem; }
  .resource-link { border-bottom: 1px solid currentColor; display: inline-block; font-size: .8rem; padding-bottom: .15rem; }
  .resource-link:hover { color: var(--muted); }
  .work-links.paired-videos { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; column-gap: clamp(1rem, 3vw, 2rem); }
  .catalogue-link { display: inline-flex; flex-direction: column; align-items: flex-start; text-align: left; gap: .5rem; margin: 0 0 3rem; font-size: .625rem; line-height: 1.4; letter-spacing: .03em; }
  .catalogue-link img { display: block; width: 1.5rem; height: 1.5rem; }
  .catalogue-link:hover { color: var(--muted); }
  @media(max-width: 600px) { .section-title { padding: 1rem 4vw 0; } .work-text { margin-inline: 4vw; } }
</style>
