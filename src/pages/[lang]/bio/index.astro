---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { copy, isLanguage, languages, type Language } from '../../../i18n';
import portrait from '../../../assets/elia-gasparolo-bio.webp';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const requestedLang = Astro.params.lang;
const lang: Language = isLanguage(requestedLang) ? requestedLang : 'es';
const t = copy[lang].bioStatement;
const base = import.meta.env.BASE_URL;
const cvHref = `${base}cv/elia-gasparolo-cv-${lang}.pdf`;
---

<BaseLayout lang={lang} title={`Elia Gasparolo — ${t.title}`}>
  <article class="bio-statement">
    <h1>{t.title}</h1>
    <div class="introduction">
      <figure>
        <Image src={portrait} alt={t.imageAlt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 899px) 92vw, 31vw" loading="eager" />
      </figure>

      <div class="content">
        <section aria-labelledby="statement-title">
          <h2 id="statement-title">{t.statementTitle}</h2>
          {t.statement.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section aria-labelledby="bio-title">
          <h2 id="bio-title">{t.bioTitle}</h2>
          {t.bio.map((paragraph) => <p>{paragraph}</p>)}
          <a class="cv-link" href={cvHref} target="_blank" rel="noopener noreferrer">{t.cvLabel}</a>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .bio-statement { margin: 0 auto; max-width: 100rem; padding: clamp(2rem, 5vw, 5rem); }
  h1 { font-size: clamp(1.45rem, 2.1vw, 2.2rem); font-weight: 500; letter-spacing: -.035em; margin: 0 0 clamp(2.5rem, 6vw, 6rem); }
  .introduction { display: grid; gap: clamp(2.5rem, 6vw, 7rem); grid-template-columns: minmax(12rem, .75fr) minmax(0, 1.25fr); }
  figure { margin: 0; }
  figure :global(img) { display: block; height: auto; width: 100%; }
  .content { max-width: 44rem; }
  section + section { margin-top: clamp(3.5rem, 8vw, 8rem); }
  h2 { font-size: 1rem; font-weight: 500; letter-spacing: .025em; margin: 0 0 1.5rem; }
  p { font-size: clamp(.8rem, .85vw, .95rem); line-height: 1.65; margin: 0; }
  p + p { margin-top: 1.15rem; }
  .cv-link { border-bottom: 1px solid currentColor; display: inline-block; font-size: .8rem; margin-top: 2rem; padding-bottom: .15rem; }

  @media (max-width: 899px) {
    .bio-statement { padding: 2.5rem 4vw 4rem; }
    h1 { margin-bottom: 2.5rem; }
    .introduction { gap: 2.5rem; grid-template-columns: 1fr; }
    figure { max-width: 32rem; }
    section + section { margin-top: 4rem; }
  }
</style>
