---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { isLanguage, languages } from '../../../i18n';
import { works } from '../../../works-content';

export function getStaticPaths() {
  return languages.flatMap((lang) => works.map((work) => ({ params: { lang, slug: work.slug } })));
}

const { lang: langParam, slug } = Astro.params;
const lang = isLanguage(langParam) ? langParam : 'es';
const work = works.find((item) => item.slug === slug);

if (!work) {
  throw new Error(`Work not found: ${slug}`);
}

const base = import.meta.env.BASE_URL;
const paragraphs = work.body[lang]
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.replace(/\s*\n\s*/g, ' ').trim())
  .filter(Boolean);
---

<BaseLayout lang={lang} title={`${work.title[lang]} — Elia Gasparolo`}>
  <article class="work-page">
    <h1>{work.title[lang]}</h1>

    <div class="work-slider" aria-label={work.title[lang]}>
      {work.images.map((image, index) => (
        <figure>
          <img src={`${base}${image}`} alt={`${work.title[lang]} — ${index + 1}`} loading={index > 1 ? 'lazy' : 'eager'} />
        </figure>
      ))}
    </div>

    <div class="work-text">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </article>
</BaseLayout>

<style>
  .work-page { margin: 0 auto; max-width: 110rem; padding: clamp(2rem, 5vw, 5rem); }
  h1 { font-size: clamp(1.45rem, 2.1vw, 2.2rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.1; margin: 0 0 clamp(3rem, 8vw, 8rem); }
  .work-slider { display: flex; gap: clamp(.75rem, 2vw, 1.5rem); margin: 0; overflow-x: auto; overscroll-behavior-x: contain; padding: 0 0 .75rem; scroll-snap-type: x mandatory; scrollbar-color: rgba(25,25,24,.35) transparent; scrollbar-width: thin; }
  figure { flex: 0 0 auto; height: clamp(18rem, 40vw, 34rem); margin: 0; scroll-snap-align: start; width: fit-content; }
  figure img { display: block; height: 100%; width: auto; }
  .work-text { font-size: clamp(.8rem, .85vw, .95rem); line-height: 1.65; margin-top: clamp(3rem, 7vw, 8rem); max-width: 44rem; }
  .work-text p { margin: 0; }
  .work-text p + p { margin-top: 1.15rem; }
  @media (max-width: 600px) { .work-page { padding: 2.5rem 4vw 4rem; } .work-slider { margin-left: -4vw; margin-right: -4vw; padding-left: 4vw; padding-right: 4vw; } figure { height: clamp(18rem, 80vw, 28rem); } }
</style>
