---
interface Props {}
import { routeContext } from "../../../routing";
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { copy, isLanguage, languages } from '../../../i18n';
import { workCovers } from '../../../work-covers';
import { works } from '../../../works-content';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang: langParam } = routeContext(Astro.url.pathname);
const lang = isLanguage(langParam) ? langParam : 'es';
const base = import.meta.env.BASE_URL;
const route = routeContext(Astro.url.pathname);
---

<BaseLayout lang={lang} title={`${copy[lang].navigation.works} — Elia Gasparolo`}>
  <article class="works-page">
    <h1 class="works-title section-title">{copy[lang].navigation.works}</h1>

    <div class="works-layout">
      <div class="works-grid">
        {works.map((work, index) => (
          <article class="work-card" data-work={work.slug}>
            <a class="work-image" href={route.href(`obras/${work.slug}`)} aria-label={work.title[lang]} data-work-trigger={work.slug}>
              <img src={`${base}${workCovers[work.slug]}`} alt={work.title[lang]} loading={index < 6 ? 'eager' : 'lazy'} />
            </a>
          </article>
        ))}
      </div>

      <aside class="works-index" aria-label={copy[lang].navigation.works}>
        <ol class="works-legend">
          {works.map((work, index) => (
            <li data-work={work.slug}>
              <a href={route.href(`obras/${work.slug}`)} data-work-trigger={work.slug}><span>{index + 1}.</span> {work.title[lang]}</a>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('.works-page').forEach((page) => {
    const linked = page.querySelectorAll<HTMLElement>('[data-work]');
    const setHighlight = (slug?: string) => linked.forEach((item) => item.classList.toggle('is-highlighted', item.dataset.work === slug));

    page.querySelectorAll<HTMLElement>('[data-work-trigger]').forEach((trigger) => {
      const slug = trigger.dataset.workTrigger;
      trigger.addEventListener('pointerenter', () => setHighlight(slug));
      trigger.addEventListener('pointerleave', () => setHighlight());
      trigger.addEventListener('focus', () => setHighlight(slug));
      trigger.addEventListener('blur', () => setHighlight());
    });
  });
</script>

<style>
  .works-page { margin: 0 auto; max-width: 110rem; padding: clamp(2rem, 5cqw, 5rem); }
  .works-layout { align-items: start; display: grid; gap: 2.5cqw; grid-template-columns: minmax(0, 1fr) 12rem; }
  .works-grid { display: grid; gap: 1.5cqw; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .work-card { min-width: 0; }
  .work-image { display: block; position: relative; }
  .work-card img { aspect-ratio: 3 / 2; display: block; object-fit: contain; transition: opacity 250ms ease; width: 100%; }
  .work-image:hover img, .work-card.is-highlighted img { opacity: .75; }
  .works-index { position: sticky; top: calc(var(--content-header-height) + 2rem); max-height: calc(100svh - var(--content-header-height) - 4rem); overflow-y: auto; }
  .works-legend { color: #6e7357; font-size: .75rem; line-height: 1.8; list-style: none; margin: 0; padding: 0; }
  .works-legend li { display: inline; }
  .works-legend li:not(:last-child)::after { content: ' · '; color: var(--line); }
  .works-legend span { color: var(--ink); }
  .works-legend a:hover, .works-legend a:focus-visible { text-decoration: underline; }
  .works-legend li.is-highlighted { background: #6e735725; color: var(--ink); }
  @container content (max-width: 1100px) { .works-layout { grid-template-columns: 1fr; } .works-index { max-height: none; position: static; padding-top: 2rem; } }
  @container content (max-width: 600px) { .works-page { padding: 2.5rem 4vw 4rem; } .works-grid { gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
