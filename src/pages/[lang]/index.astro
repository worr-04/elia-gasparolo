---
interface Props {}
import { routeContext } from "../../routing";
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkSlider from '../../components/WorkSlider.astro';
import { copy, languages, type Language } from '../../i18n';
import tejidoConectivo from '../../assets/home-optimized/01-tejido-conectivo.webp';
import collarDeMandarinas from '../../assets/home-optimized/02-collar-de-mandarinas.webp';
import laPropension from '../../assets/home-optimized/03-la-propension.webp';
import reliquias from '../../assets/home-optimized/04-reliquias.webp';
import intocable from '../../assets/home-optimized/05-intocable.webp';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = routeContext(Astro.url.pathname).lang as Language;
const t = copy[lang];

const images = [tejidoConectivo, collarDeMandarinas, laPropension, reliquias, intocable];
const works = t.home.works.map((work, index) => ({ ...work, image: images[index] }));
---

<BaseLayout lang={lang} fullViewport>
  <div class="home">
    <h1 class="visually-hidden">Elia Gasparolo</h1>
    <WorkSlider
      works={works}
      label={t.home.sliderLabel}
      empty={t.home.empty}
      emptyDetail={t.home.emptyDetail}
    />
  </div>
</BaseLayout>

<style>
  .visually-hidden { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); }
  .home { height: 100%; min-height: 0; }
</style>
