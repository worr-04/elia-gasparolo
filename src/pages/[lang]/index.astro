---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkSlider from '../../components/WorkSlider.astro';
import { copy, languages, type Language } from '../../i18n';
import tejidoConectivo from '../../assets/home-optimized/01-tejido-conectivo.webp';
import collarDeMandarinas from '../../assets/home-optimized/02-collar-de-mandarinas.webp';
import laPropension from '../../assets/home-optimized/03-la-propension.webp';
import reliquias from '../../assets/home-optimized/04-reliquias.webp';
import intocable from '../../assets/home-optimized/05-intocable.webp';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
const t = copy[lang];

const images = [tejidoConectivo, collarDeMandarinas, laPropension, reliquias, intocable];
const works = t.home.works.map((work, index) => ({ ...work, image: images[index] }));
---

<BaseLayout lang={lang} fullViewport>
  <div class="home">
    <h1 class="visually-hidden">Elia Gasparolo</h1>
    <WorkSlider
      works={works}
      label={t.home.sliderLabel}
      empty={t.home.empty}
      emptyDetail={t.home.emptyDetail}
    />
  </div>
</BaseLayout>

<style>
  .visually-hidden { height: 1px; margin: -1px; overflow: hidden; padding: 0; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  /* Base compartida por todas las pantallas. */
  .home { align-items: center; display: flex; height: 100%; justify-content: center; overflow: hidden; padding: clamp(2rem, 4.5vw, 5rem); }

  /* Tablet y mobile: hasta 899 px. */
  @media (max-width: 899px) {
    .home {
      align-items: flex-start;
      min-height: 0;
      /* arriba (separación del header) | laterales | abajo */
      padding: 2svh  12rem;
    }
  }

  /* Solo tablet: de 601 px a 899 px. */
  @media (min-width: 601px) and (max-width: 899px) {
    .home {
      /* arriba desde el header | laterales | abajo */
      padding: 4svh 4% 8svh;
    }
  }

  /* Solo mobile vertical: hasta 600 px. */
  @media (max-width: 600px) {
    .home {
      /* arriba desde el header | laterales | abajo */
      padding: clamp(3rem, 8svh, 5rem) 4vw 1.5rem;
    }
  }

  /* Solo mobile horizontal: hasta 600 px y teléfono girado. */
  @media (max-width: 600px) and (orientation: landscape) {
    .home {
      height: auto;
      min-height: 100%;
      overflow: visible;
      padding-top: 3rem;
    }
  }

  /* Solo desktop: desde 900 px. */
  @media (min-width: 900px) {
    .home {
      align-items: center;
      /* reduce los márgenes para dar a la obra ~20% más de espacio útil */
      /* arriba (igual al header) | derecha | abajo | izquierda */
      padding: clamp(4rem, 12vw, 3.5rem) 12% 6svh 12%;
    }
  }
</style>
