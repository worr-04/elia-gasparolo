---
interface Props {}
import { routeContext } from "../../routing";
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkSlider from '../../components/WorkSlider.astro';
import { copy, languages, type Language } from '../../i18n';
import tejidoConectivo from '../../assets/home-final/01-home.webp';
import laPropension from '../../assets/home-final/02-home.webp';
import intocable from '../../assets/home-final/03-home.webp';
import reliquias from '../../assets/home-final/04-home.webp';
import accion from '../../assets/home-final/05-home.webp';
import reliquiasMarco from '../../assets/home-final/06-home.webp';
import proyeccion from '../../assets/home-final/07-home.webp';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = routeContext(Astro.url.pathname).lang as Language;
const t = copy[lang];

const works = [
  { image: tejidoConectivo, title: 'Instalación Tejido Conectivo' },
  { image: laPropension, title: 'La Propensión III' },
  { image: intocable, title: 'Intocable' },
  { image: reliquias, title: 'Reliquias' },
  { image: accion, title: lang === 'es' ? 'Acción con fuego entre rocas' : 'Action with fire among rocks' },
  { image: reliquiasMarco, title: 'Reliquias' },
  { image: proyeccion, title: lang === 'es' ? 'Cuerpo y proyección de luz' : 'Body and light projection' },
];
---

<BaseLayout lang={lang} fullViewport>
  <div class="home">
    <h1 class="visually-hidden">Elia Gasparolo</h1>
    <WorkSlider
      works={works}
      label={t.home.sliderLabel}
      empty={t.home.empty}
      emptyDetail={t.home.emptyDetail}
    />
  </div>
</BaseLayout>

<style>
  .visually-hidden { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); }
  .home { height: 100%; min-height: 0; }
</style>
