---
import '../styles/global.css';
import Header from '../components/Header.astro';
import type { Language } from '../i18n';
import socialImage from '../assets/elia-gasparolo-bio.webp';

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  fullViewport?: boolean;
}

const { lang, title = 'Elia Gasparolo', description, fullViewport = false } = Astro.props;
const defaultDescription = lang === 'es'
  ? 'Elia Gasparolo es una artista visual argentina. Su práctica explora biomateriales, textiles, memoria y transformación.'
  : 'Elia Gasparolo is an Argentine visual artist whose practice explores biomaterials, textiles, memory, and transformation.';
const metaDescription = description ?? defaultDescription;
const siteUrl = Astro.site ?? Astro.url.origin;
const base = import.meta.env.BASE_URL;
const localPath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname.replace(/^\//, '');
const pageSuffix = localPath.replace(/^(es|en)\/?/, '');
const alternateUrl = (target: Language) => new URL(`${base}${target}/${pageSuffix}`, siteUrl).href;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(socialImage.src, siteUrl).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Elia Gasparolo',
  url: new URL(base, siteUrl).href,
  jobTitle: lang === 'es' ? 'Artista visual' : 'Visual artist',
  description: metaDescription,
  image: socialImageUrl,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fdfcf9" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={alternateUrl('es')} />
    <link rel="alternate" hreflang="en" href={alternateUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={alternateUrl('es')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <div class:list={{ 'site-shell': true, 'full-viewport': fullViewport }}>
      <Header lang={lang} />
      <main id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .site-shell {
    min-height: 100svh;
  }

  main { margin-left: 20%; min-width: 0; width: 80%; }

  .full-viewport { height: 100svh; overflow: hidden; }

  .full-viewport main { height: 100%; }

  .skip-link {
    background: var(--ink);
    color: var(--canvas);
    left: 1rem;
    padding: .7rem .9rem;
    position: fixed;
    top: -4rem;
    transition: top 160ms ease;
    z-index: 10;
  }

  .skip-link:focus { top: 1rem; }

  @media (max-width: 899px) {
    .site-shell {
      display: flex;
      flex-direction: column;
    }

    main { margin-left: 0; order: 2; width: 100%; }

    .full-viewport main { flex: 1; height: auto; min-height: 0; }
  }

  @media (max-width: 600px) and (orientation: landscape) {
    .full-viewport main { overflow-y: auto; }
  }
</style>
