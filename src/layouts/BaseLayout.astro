---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { routeContext } from '../routing';
import LegacyHeader from '../components/LegacyHeader.astro';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Language } from '../i18n';
import { canonicalPath, sectionDescription, serializeJsonLd } from '../seo';
import socialImage from '../assets/elia-gasparolo-bio.webp';

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  fullViewport?: boolean;
  image?: string;
  artwork?: { name: string; images: string[] };
  noindex?: boolean;
}

const { lang, title = 'Elia Gasparolo', description, fullViewport = false, image, artwork, noindex = false } = Astro.props;
const siteUrl = Astro.site ?? Astro.url.origin;
const base = import.meta.env.BASE_URL;
const route = routeContext(Astro.url.pathname);
const metaDescription = description ?? sectionDescription(lang, route.suffix);
const alternateUrl = (target: Language) => new URL(canonicalPath(base, target, route.suffix), siteUrl).href;
const canonicalUrl = alternateUrl(lang);
const socialImageUrl = new URL(image ?? socialImage.src, siteUrl).href;
const artist = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Elia Gasparolo',
  url: new URL(base, siteUrl).href,
  jobTitle: lang === 'es' ? 'Artista visual' : 'Visual artist',
  '@id': new URL(`${base}#artist`, siteUrl).href,
  image: new URL(socialImage.src, siteUrl).href,
};
const structuredData = [artist, {
  '@context': 'https://schema.org', '@type': artwork ? 'VisualArtwork' : 'WebPage',
  name: artwork?.name ?? title, url: canonicalUrl, description: metaDescription,
  inLanguage: lang,
  ...(artwork ? { creator: { '@id': artist['@id'] }, image: artwork.images.map(path => new URL(path, siteUrl).href) } : { about: { '@id': artist['@id'] } }),
}];
const jsonLd = serializeJsonLd(structuredData);
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(jsonLd).digest('base64')}`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={route.proposal || noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&amp;display=swap" />
    <meta name="theme-color" content="#fdfcf9" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={alternateUrl('es')} />
    <link rel="alternate" hreflang="en" href={alternateUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={alternateUrl('es')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={artwork?.name ?? "Elia Gasparolo"} />
    <meta property="og:site_name" content="Elia Gasparolo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={jsonLd} />
    <title>{title}</title>
  </head>
  <body data-variant={route.variant} data-home={String(fullViewport)}>
    <a class="skip-link" href="#main-content">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <div class:list={{ 'site-shell': true, 'full-viewport': fullViewport }}>
      {route.variant === 2 ? <LegacyHeader lang={lang} /> : <Header lang={lang} />}
      <main id="main-content">
        <slot />
      </main>
    </div>
    <SiteFooter />
  </body>
</html>

<style>
  .site-shell { display: flex; flex-direction: column; min-height: 100svh; padding-top: var(--header-height); }
  main { flex: 1; min-width: 0; width: 100%; container-type: inline-size; container-name: content; --content-header-height: var(--header-height); }
  :global([data-variant="1"].menu-interacted) :is(main, .site-footer) { transition: transform var(--menu-duration) var(--menu-ease); }
  :global([data-variant="1"].menu-is-open) :is(main, .site-footer) { transform: translateX(calc(-1 * var(--menu-width))); }
  @media (prefers-reduced-motion: reduce) { :global([data-variant="1"].menu-interacted) :is(main, .site-footer) { transition: none; } }
  .full-viewport { height: 100svh; }
  .full-viewport main { height: auto; min-height: 0; }
  @media (min-width: 900px) {
    :global([data-variant="2"]) .site-shell { padding-top: 0; }
    :global([data-variant="2"]) main { margin-left: 20%; width: 80%; --content-header-height: 0px; }
  }
  @media (max-width: 899px) {
    :global([data-variant="2"]) .site-shell { padding-top: 0; display: flex; flex-direction: column; }
    :global([data-variant="2"]) .full-viewport main { flex: 1; height: auto; min-height: 0; }
  }
  .skip-link { background: var(--ink); color: var(--canvas); left: 1rem; padding: .7rem .9rem; position: fixed; top: -4rem; z-index: 30; }
  .skip-link:focus { top: 1rem; }
</style>
