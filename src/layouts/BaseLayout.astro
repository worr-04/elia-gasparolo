---
import '../styles/global.css';
import { routeContext } from '../routing';
import LegacyHeader from '../components/LegacyHeader.astro';
import Header from '../components/Header.astro';
import type { Language } from '../i18n';
import socialImage from '../assets/elia-gasparolo-bio.webp';

interface Props {
  lang: Language;
  title?: string;
  description?: string;
  fullViewport?: boolean;
}

const { lang, title = 'Elia Gasparolo', description, fullViewport = false } = Astro.props;
const defaultDescription = lang === 'es'
  ? 'Elia Gasparolo es una artista visual argentina. Su práctica explora biomateriales, textiles, memoria y transformación.'
  : 'Elia Gasparolo is an Argentine visual artist whose practice explores biomaterials, textiles, memory, and transformation.';
const metaDescription = description ?? defaultDescription;
const siteUrl = Astro.site ?? Astro.url.origin;
const base = import.meta.env.BASE_URL;
const route = routeContext(Astro.url.pathname);
const alternateUrl = (target: Language) => new URL(route.href(route.suffix, target), siteUrl).href;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const socialImageUrl = new URL(socialImage.src, siteUrl).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Elia Gasparolo',
  url: new URL(base, siteUrl).href,
  jobTitle: lang === 'es' ? 'Artista visual' : 'Visual artist',
  description: metaDescription,
  image: socialImageUrl,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={route.proposal ? 'noindex, follow' : 'index, follow'} />
    <meta name="theme-color" content="#fdfcf9" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={alternateUrl('es')} />
    <link rel="alternate" hreflang="en" href={alternateUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={alternateUrl('es')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body data-variant={route.variant} data-home={String(fullViewport)}>
    <a class="skip-link" href="#main-content">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <div class:list={{ 'site-shell': true, 'full-viewport': fullViewport }}>
      {route.variant === 2 ? <LegacyHeader lang={lang} /> : <Header lang={lang} />}
      <main id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .site-shell { min-height: 100svh; padding-top: var(--header-height); }
  main { min-width: 0; width: 100%; container-type: inline-size; container-name: content; --content-header-height: var(--header-height); }
  :global([data-variant="1"]) main { transition: transform var(--menu-duration) var(--menu-ease); }
  :global([data-variant="1"].menu-is-open) main { transform: translateX(calc(-1 * var(--menu-width))); }
  @media (prefers-reduced-motion: reduce) { :global([data-variant="1"]) main { transition: none; } }
  .full-viewport { height: 100svh; }
  .full-viewport main { height: 100%; }
  @media (min-width: 900px) {
    :global([data-variant="2"]) .site-shell { padding-top: 0; }
    :global([data-variant="2"]) main { margin-left: 20%; width: 80%; --content-header-height: 0px; }
  }
  @media (max-width: 899px) {
    :global([data-variant="2"]) .site-shell { padding-top: 0; display: flex; flex-direction: column; }
    :global([data-variant="2"]) .full-viewport main { flex: 1; height: auto; min-height: 0; }
  }
  .skip-link { background: var(--ink); color: var(--canvas); left: 1rem; padding: .7rem .9rem; position: fixed; top: -4rem; z-index: 30; }
  .skip-link:focus { top: 1rem; }
</style>
