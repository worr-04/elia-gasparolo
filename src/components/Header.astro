---
import { copy, type Language } from '../i18n';

interface Props { lang: Language; }

const { lang } = Astro.props;
const t = copy[lang];
const base = import.meta.env.BASE_URL;
const otherLang: Language = lang === 'es' ? 'en' : 'es';
const otherLangLabel = otherLang.toUpperCase();
const nav = [
  ['bio', t.navigation.bio],
  ['statement', t.navigation.statement],
  ['obras', t.navigation.works],
  ['colaboraciones', t.navigation.collaborations],
  ['texto', t.navigation.text],
  ['prensa', t.navigation.press],
] as const;
---

<header class="site-header">
  <a class="identity" href={`${base}${lang}/`} aria-label="Elia Gasparolo — Home">Elia Gasparolo</a>
  <nav aria-label="Navegación principal">
    <ul>
      {nav.map(([slug, label]) => <li><a href={`${base}${lang}/${slug}/`}>{label}</a></li>)}
    </ul>
  </nav>
  <a class="language" href={`${base}${otherLang}/`} aria-label={`Cambiar idioma a ${otherLangLabel}`}>
    <span class:list={{ active: lang === 'es' }}>ES</span><span aria-hidden="true"> / </span><span class:list={{ active: lang === 'en' }}>EN</span>
  </a>
</header>

<style>
  .site-header {
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    height: 100svh;
    inset: 0 auto 0 0;
    justify-content: flex-start;
    padding: clamp(1.5rem, 3vw, 3.5rem);
    position: fixed;
    width: 20%;
    z-index: 1;
  }

  .identity { font-size: clamp(1.5rem, 1.875vw, 1.875rem); font-weight: 500; letter-spacing: -0.04em; }
  nav { margin-top: clamp(3rem, 8vh, 6rem); }
  ul { display: grid; gap: .65rem; list-style: none; margin: 0; padding: 0; }
  nav a, .language { font-size: 1.05rem; letter-spacing: .035em; }
  nav a { transition: color 160ms ease; }
  nav a:hover, nav a:focus-visible { color: var(--muted); }
  .language { align-self: flex-start; color: var(--muted); margin-top: auto; }
  .language .active { color: var(--ink); font-weight: 600; }

  @media (max-width: 899px) {
    .site-header {
      border-bottom: 1px solid var(--line);
      border-right: 0;
      gap: 1.4rem;
      height: auto;
      inset: auto;
      padding: 1.25rem 1.5rem;
      position: static;
      width: auto;
    }
    nav { margin-top: 0; overflow-x: auto; scrollbar-width: none; }
    ul { display: flex; gap: 1.25rem; min-width: max-content; }
    .language { position: absolute; right: 1.5rem; top: 1.35rem; }
  }
</style>
