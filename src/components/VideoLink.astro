---
interface Props {
  href: string;
  image: string;
  width: number;
  height: number;
  description: string;
  labelPosition?: 'above' | 'beside';
}
const { href, image, width, height, description, labelPosition = 'beside' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class:list={{ "video-card": true, "label-above": labelPosition === 'above' }} href={href} target="_blank" rel="noopener noreferrer">
  <span class="video-label">
    <img class="video-icon" src={`${base}icons/video.png`} width="512" height="512" alt="" />
    <span>VIDEO</span>
  </span>
  <span class="video-cover">
    <img class="cover-image" src={image} width={width} height={height} loading="lazy" alt="" />
    <svg class="play-overlay" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="23" /><path d="m20 15 14 9-14 9z" /></svg>
  </span>
  <span class="video-description">{description}</span>
</a>
<style>
  .video-card { display: grid; gap: .75rem; min-width: 0; width: 100%; max-width: 23.75rem; grid-template-columns: 2rem minmax(0, 21rem); align-items: start; }
  .label-above { max-width: 21rem; grid-template-columns: minmax(0, 1fr); }
  .label-above .video-label, .label-above .video-cover, .label-above .video-description { grid-column: 1; grid-row: auto; }
  .video-label { grid-column: 1; grid-row: 1; display: grid; justify-items: center; justify-self: start; width: max-content; text-align: center; gap: .25rem; font-size: .5625rem; line-height: 1.4; letter-spacing: .04em; }
  .video-icon { width: 1.125rem; height: 1.125rem; object-fit: contain; }
  img { display: block; width: 100%; height: auto; }
  .video-cover { grid-column: 2; grid-row: 1; display: block; position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; }
  .cover-image { height: 100%; object-fit: cover; transition: opacity 180ms ease; }
  .play-overlay { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: block; width: 2.75rem; height: 2.75rem; transition: opacity 180ms ease; }
  .play-overlay circle { fill: #0006; stroke: #fff; stroke-width: 1; }
  .play-overlay path { fill: #fff; }
  .video-card:hover .cover-image, .video-card:focus-visible .cover-image { opacity: .75; }
  .video-card:hover .play-overlay, .video-card:focus-visible .play-overlay { opacity: .75; }
  @media (prefers-reduced-motion: reduce) { .cover-image, .play-overlay { transition: none; } }
  .video-description { grid-column: 2; font-size: .8rem; line-height: 1.6; }
  .video-card:hover .video-label, .video-card:focus-visible .video-label { color: var(--muted); }
</style>
