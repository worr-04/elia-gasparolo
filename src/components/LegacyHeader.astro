---
import { routeContext } from '../routing';
import { copy, type Language } from '../i18n';

interface Props { lang: Language; }

const { lang } = Astro.props;
const t = copy[lang];
const route = routeContext(Astro.url.pathname);
const languageHref = (target: Language) => route.href(route.suffix, target);
const isCurrentPage = (slug: string) => route.suffix.split('/')[0] === slug;
const nav = [
  ['bio', t.navigation.bio],
  ['obras', t.navigation.works],
  ['colaboraciones', t.navigation.collaborations],
  ['texto', t.navigation.text],
  ['prensa', t.navigation.press],
] as const;
---

<header class="legacy-header">
  <a class="identity" href={route.href()} aria-label="Elia Gasparolo — Home">ELIA GASPAROLO</a>
  <button class="menu-toggle" type="button" aria-controls="mobile-navigation" aria-expanded="false" data-menu-toggle>
    <span class="menu-lines" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="sr-only">Abrir menú</span>
  </button>
  <nav id="mobile-navigation" aria-label="Navegación principal">
    <ul>
      {nav.map(([slug, label]) => <li><a href={route.href(slug)} aria-current={isCurrentPage(slug) ? 'page' : undefined}>{label}</a></li>)}
    </ul>
    <div class="language mobile-language" aria-label="Cambiar idioma">
      <a class:list={{ active: lang === 'es' }} href={languageHref('es')}>ES</a><span aria-hidden="true"> / </span><a class:list={{ active: lang === 'en' }} href={languageHref('en')}>EN</a>
    </div>
  </nav>
  <div class="language" aria-label="Cambiar idioma">
    <a class:list={{ active: lang === 'es' }} href={languageHref('es')}>ES</a><span aria-hidden="true"> / </span><a class:list={{ active: lang === 'en' }} href={languageHref('en')}>EN</a>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('.legacy-header').forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const label = toggle?.querySelector<HTMLElement>('.sr-only');
    toggle?.addEventListener('click', () => {
      const isOpen = header.classList.toggle('menu-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
      if (label) label.textContent = isOpen ? 'Cerrar menú' : 'Abrir menú';
    });
  });
</script>

<style>
  .legacy-header {
    display: flex;
    flex-direction: column;
    height: 100svh;
    inset: 0 auto 0 0;
    justify-content: flex-start;
    padding: var(--sidebar-edge-space);
    position: fixed;
    width: 20%;
    z-index: 1;
  }

  .identity { font-size: clamp(1.2rem, 1.5vw, 1.5rem); font-weight: 500; letter-spacing: -0.04em; }
  nav { margin-top: clamp(3rem, 8vh, 6rem); }
  ul { display: grid; gap: .65rem; list-style: none; margin: 0; padding: 0; }
  nav a, .language { font-size: 1.05rem; letter-spacing: .035em; }
  nav a { transition: color 160ms ease; }
  nav a:hover, nav a:focus-visible { color: var(--muted); }
  .language { align-self: flex-start; color: var(--muted); margin-top: auto; }
  .language .active { color: var(--ink); font-weight: 600; }
  .mobile-language, .menu-toggle { display: none; }
  .sr-only { height: 1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); white-space: nowrap; }

  @media (max-width: 899px) {
    .legacy-header {
      border-right: 0;
      gap: 1.4rem;
      height: auto;
      inset: auto;
      padding: 1.25rem 1.5rem;
      position: static;
      width: auto;
    }
    nav { margin-top: 0; overflow-x: auto; scrollbar-width: none; }
    ul { display: flex; gap: 1.25rem; min-width: max-content; }
    .language { position: absolute; right: 1.5rem; top: 1.35rem; }
  }

  @media (max-width: 899px) {
    .identity { max-width: calc(100% - 3rem); font-size: clamp(.88rem, 3.2vw, 1.2rem); }
    .legacy-header { height: var(--header-height); flex-shrink: 0; justify-content: center; align-items: flex-start; display: flex; padding: 0 var(--sidebar-edge-space); z-index: 3; }
    .menu-toggle { background: transparent; border: 0; cursor: pointer; display: grid; padding: .3rem 0 .3rem .6rem; position: absolute; right: 4vw; top: 1.15rem; z-index: 4; }
    .menu-lines { display: grid; gap: .28rem; width: 1.35rem; }
    .menu-lines i { background: var(--ink); display: block; height: 1px; transition: transform 180ms ease, opacity 180ms ease; width: 100%; }
    .menu-open .menu-lines i:first-child { transform: translateY(.38rem) rotate(45deg); }
    .menu-open .menu-lines i:nth-child(2) { opacity: 0; }
    .menu-open .menu-lines i:last-child { transform: translateY(-.38rem) rotate(-45deg); }
    nav { background: var(--canvas); display: flex; flex-direction: column; inset: 0; justify-content: space-between; margin: 0; overflow: hidden; padding: 7rem 4vw 2rem; position: fixed; transform: translateX(100%); transition: transform 240ms ease; visibility: hidden; z-index: 2; }
    .menu-open nav { transform: translateX(0); visibility: visible; }
    ul { display: grid; gap: 1rem; min-width: 0; }
    nav a { font-size: 1.25rem; }
    .legacy-header > .language { display: none; }
    .mobile-language { align-self: flex-start; display: inline; margin: 0; position: static; }
  }
</style>
