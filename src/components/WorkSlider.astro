---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  works: { image: ImageMetadata; title: string; year?: string; details: string[] }[];
  label: string; empty: string; emptyDetail: string;
}
const { works, label, empty, emptyDetail } = Astro.props;
const es = Astro.url.pathname.indexOf('/en/') === -1;
---
<section class="slider" aria-label={label} aria-roledescription={es ? 'Carrusel' : 'Carousel'}>
  {works.length ? <>
    {works.map(({ image, title }, index) => (
      <figure class:list={{ slide: true, current: index === 0 }} aria-hidden={index !== 0}>
        <Image src={image} alt={title} widths={[640, 1280, 1920, 2560]} sizes="100vw" loading={index === 0 ? 'eager' : 'lazy'} />
      </figure>
    ))}
    <button class="pause-control" data-pause aria-label={es ? 'Pausar presentación' : 'Pause slideshow'} data-play-label={es ? 'Reproducir presentación' : 'Play slideshow'} data-pause-label={es ? 'Pausar presentación' : 'Pause slideshow'}>Ⅱ</button>
  </> : <p>{empty} <span>{emptyDetail}</span></p>}
</section>
<script>
  document.querySelectorAll<HTMLElement>('.slider').forEach(slider => {
    const slides = slider.querySelectorAll<HTMLElement>('.slide');
    if (slides.length < 2) return;
    let current = 0;
    const pause = slider.querySelector<HTMLButtonElement>('[data-pause]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let playing = !reduced.matches;
    const sync = () => { pause.textContent = playing ? 'Ⅱ' : '▷'; pause.setAttribute('aria-label', (playing ? pause.dataset.pauseLabel : pause.dataset.playLabel)!); };
    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => { slide.classList.toggle('current', index === current); slide.setAttribute('aria-hidden', String(index !== current)); });
    };
    const move = (offset: number) => { playing = false; sync(); show(current + offset); };
    pause.addEventListener('click', () => { playing = !playing; sync(); });
    reduced.addEventListener('change', () => { if (reduced.matches) { playing = false; sync(); } });
    slider.addEventListener('keydown', event => { if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); move(event.key === 'ArrowRight' ? 1 : -1); } });
    window.setInterval(() => { if (playing && !document.hidden && !document.body.classList.contains('menu-is-open') && !slider.matches(':focus-within')) show(current + 1); }, 6500);
    sync();
  });
</script>
<style>
  .slider { height: 100%; position: relative; width: 100%; background: #292922; }
  .slide { inset: 0; margin: 0; opacity: 0; position: absolute; transition: opacity 1200ms ease; pointer-events: none; }
  .slide.current { opacity: 1; }
  .slide :global(img) { display: block; height: 100%; object-fit: cover; width: 100%; }
  .pause-control { position: absolute; bottom: 1.5rem; right: 3vw; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); border: 0; }
  .pause-control:focus-visible { width: 44px; height: 44px; clip-path: none; background: #0008; color: white; }
  @media(prefers-reduced-motion: reduce) { .slide { transition: none; } }
</style>
