---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  works: { image: ImageMetadata; title: string }[];
  label: string; empty: string; emptyDetail: string;
}
const { works, label, empty, emptyDetail } = Astro.props;
const es = Astro.url.pathname.indexOf('/en/') === -1;
---
<section class="slider" tabindex="0" aria-label={label} aria-describedby="carousel-instructions" aria-roledescription={es ? 'Carrusel' : 'Carousel'}>
  <span id="carousel-instructions" class="sr-only">{es ? 'Arrastrá para recorrer las imágenes. Con el teclado, usá las flechas; espacio pausa o reanuda.' : 'Drag to browse images. Use arrow keys to navigate; space pauses or resumes.'}</span>
  {works.length ? <>
    <div class="carousel-track">
      <div class="carousel-sequence">
        {works.map(({ image, title }) => (
          <figure data-ratio={image.width / image.height} style={`aspect-ratio: ${image.width} / ${image.height}`}>
            <Image src={image} alt={title} widths={[640, 1280, 1920, 2560]} sizes={`${image.width / image.height * 100}svh`} loading="eager" />
          </figure>
        ))}
      </div>
    </div>
  </> : <p>{empty} <span>{emptyDetail}</span></p>}
</section>
<script>
  document.querySelectorAll<HTMLElement>('.slider').forEach(slider => {
    const track = slider.querySelector<HTMLElement>('.carousel-track');
    const sequence = slider.querySelector<HTMLElement>('.carousel-sequence');
    if (!track || !sequence) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let playing = !reduced.matches;
    let offset = 0;
    let width = 0;
    let previousTime = 0;
    const secondsPerViewport = 20; // Traverse one visible carousel width in 20 seconds.
    let speed = 0;
    let pointer: number | null = null;
    let lastX = 0;
    let lastTime = 0;
    let velocity = 0;
    const advance = (distance: number) => {
      if (width) offset = ((offset + distance) % width + width) % width;
    };
    const render = () => { track.style.transform = `translate3d(${-offset}px, 0, 0)`; };
    const measure = () => {
      const height = slider.clientHeight;
      speed = slider.clientWidth / secondsPerViewport;
      const gap = parseFloat(getComputedStyle(sequence).columnGap) || 0;
      const figures = Array.from(sequence.querySelectorAll<HTMLElement>('figure'));
      if (!height || !figures.length) return;
      // Explicit sizing avoids max-content reserving the images' intrinsic widths,
      // which can leave unused space after the last figure in a sequence.
      const widths = figures.map(figure => height * Number(figure.dataset.ratio));
      const nextWidth = widths.reduce((sum, value) => sum + value, 0) + gap * figures.length;
      for (const group of Array.from(track.children) as HTMLElement[]) {
        group.style.width = `${nextWidth}px`;
        group.querySelectorAll<HTMLElement>('figure').forEach((figure, index) => {
          figure.style.width = `${widths[index]}px`;
        });
      }
      offset = width ? offset / width * nextWidth : 0;
      width = nextWidth;
      // Cover even very wide screens; each copy starts exactly one sequence apart.
      const copies = Math.ceil(slider.clientWidth / width);
      while (track.children.length > copies + 1) track.lastElementChild?.remove();
      while (track.children.length < copies + 1) {
        const clone = sequence.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.inert = true;
        track.append(clone);
      }
      render();
    };
    reduced.addEventListener('change', () => { playing = !reduced.matches; velocity = 0; });
    slider.addEventListener('pointerdown', event => {
      if (!event.isPrimary || event.button !== 0 || pointer !== null) return;
      pointer = event.pointerId;
      lastX = event.clientX;
      lastTime = event.timeStamp;
      velocity = 0;
      slider.setPointerCapture(pointer);
      slider.classList.add('is-dragging');
    });
    slider.addEventListener('pointermove', event => {
      if (event.pointerId !== pointer) return;
      const distance = lastX - event.clientX;
      const elapsed = Math.max(event.timeStamp - lastTime, 1);
      velocity = Math.max(-1800, Math.min(1800, distance / elapsed * 1000));
      advance(distance);
      lastX = event.clientX;
      lastTime = event.timeStamp;
      render();
    });
    const release = (event: PointerEvent) => {
      if (event.pointerId !== pointer) return;
      if (event.type !== 'pointerup' || event.timeStamp - lastTime > 100 || reduced.matches) velocity = 0;
      pointer = null;
      slider.classList.remove('is-dragging');
      if (slider.hasPointerCapture(event.pointerId)) slider.releasePointerCapture(event.pointerId);
    };
    slider.addEventListener('pointerup', release);
    slider.addEventListener('pointercancel', release);
    slider.addEventListener('lostpointercapture', release);
    slider.addEventListener('keydown', event => {
      if (event.key === ' ') { event.preventDefault(); playing = !playing; velocity = 0; return; }
      if (!width || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      velocity = 0;
      advance((event.key === 'ArrowRight' ? 1 : -1) * slider.clientWidth * .5);
      render();
    });
    const observer = new ResizeObserver(measure);
    observer.observe(slider);
    const frame = (time: number) => {
      const elapsed = previousTime ? Math.min(time - previousTime, 64) / 1000 : 0;
      previousTime = time;
      if (pointer === null && width && !document.hidden && !document.body.classList.contains('menu-is-open')) {
        // Release momentum eases back into the slow automatic movement.
        advance(((playing ? speed : 0) + velocity) * elapsed);
        velocity *= Math.exp(-3 * elapsed);
        if (Math.abs(velocity) < .1) velocity = 0;
        render();
      }
      requestAnimationFrame(frame);
    };
    measure(); requestAnimationFrame(frame);
  });
</script>
<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .slider { height: 100%; max-height: 100%; overflow: hidden; position: relative; width: 100%; background: #fff; cursor: grab; touch-action: pan-y; user-select: none; --carousel-gap: clamp(4px, .4vw, 8px); }
  .slider.is-dragging { cursor: grabbing; }
  .slider:focus-visible { outline: 2px solid #888; outline-offset: -2px; }
  .carousel-track { pointer-events: none; display: flex; height: 100%; width: max-content; will-change: transform; }
  .carousel-sequence { gap: var(--carousel-gap); padding-right: var(--carousel-gap); display: flex; flex: none; height: 100%; width: max-content; }
  figure { flex: none; height: 100%; width: auto; margin: 0; }
  figure :global(img) { display: block; height: 100%; width: 100%; max-width: none; object-fit: contain; }
</style>
