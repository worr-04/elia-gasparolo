---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  works: {
    image: ImageMetadata;
    title: string;
    year?: string;
    details: string[];
  }[];
  label: string;
  empty: string;
  emptyDetail: string;
}

const { works, label, empty, emptyDetail } = Astro.props;
---

<section class="slider" aria-label={label}>
  {works.length > 0 ? (
    <div class="viewport">
      <div class="track">
        {works.map(({ image, title, year }, index) => (
          <figure class:list={{ slide: true, current: index === 0 }} data-slide>
            <div class="artwork">
              <Image src={image} alt={title} data-work-image widths={[640, 960, 1280]} sizes="(max-width: 899px) calc(100vw - 3rem), 64vw" loading={index === 0 ? 'eager' : 'lazy'} />
              <figcaption data-caption>
                <em>{title}</em>
                {year && <span>{year}</span>}
              </figcaption>
            </div>
          </figure>
        ))}
      </div>
    </div>
  ) : (
    <div class="placeholder">
      <p>{empty}</p>
      <span>{emptyDetail}</span>
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('.slider').forEach((slider) => {
    const slides = slider.querySelectorAll<HTMLElement>('[data-slide]');
    let current = 0;

    const setCurrent = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => slide.classList.toggle('current', index === current));
    };

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (slides.length > 1 && !reducedMotion) window.setInterval(() => setCurrent(current + 1), 5000);

    const syncCaptions = () => {
      slider.querySelectorAll<HTMLImageElement>('[data-work-image]').forEach((image) => {
        const caption = image.parentElement?.querySelector<HTMLElement>('[data-caption]');
        if (caption) caption.style.width = `${image.getBoundingClientRect().width}px`;
      });
    };

    slider.querySelectorAll<HTMLImageElement>('[data-work-image]').forEach((image) => {
      image.addEventListener('load', syncCaptions);
    });
    window.addEventListener('resize', syncCaptions);
    syncCaptions();
  });
</script>

<style>
  :global(:root) { --slider-caption-gap: 1rem; }
  .slider { height: 100%; width: min(100%, 70rem); }
  .viewport, .track { height: 100%; }
  .track { position: relative; }
  .slide { align-items: center; display: flex; inset: 0; justify-content: center; margin: 0; opacity: 0; position: absolute; transition: opacity 400ms ease; }
  .slide.current { opacity: 1; }
  .artwork { align-items: center; display: flex; flex-direction: column; max-width: 100%; }
  .slide :global(img) { display: block; height: 100%; max-width: 100%; object-fit: cover; width: 100%; }
  figcaption { color: var(--ink); display: grid; gap: .25rem; margin-top: var(--slider-caption-gap); max-width: 100%; }
  figcaption em { font-size: .85rem; font-weight: 500; }
  figcaption span { font-size: .65rem; line-height: 1.45; }
  .placeholder { align-content: center; aspect-ratio: 4 / 3; border: 1px solid var(--line); color: var(--muted); display: grid; justify-items: center; }
  .placeholder p { color: var(--ink); font-size: .75rem; letter-spacing: .04em; margin: 0 0 .55rem; text-transform: uppercase; }
  .placeholder span { font-size: .65rem; }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; } }
  @media (max-width: 899px) {
    .slider { height: 30svh; width: 100%; }
    .slide { justify-content: flex-start; }
    .slide :global(img) { height: 100%; width: 100%; }
  }

  @media (min-width: 601px) and (max-width: 899px) {
    .slider { height: 42svh; }
  }

  @media (max-width: 600px) {
    .slider { height: 100%; padding-bottom: 3.5rem; }
    .viewport, .track { height: 100%; }
  }

  @media (max-width: 600px) and (orientation: landscape) {
    .slider { height: 22rem; }
  }

  @media (min-width: 900px) {
    .slider { height: auto; padding-bottom: 4rem; width: 100%; }
    .viewport { height: auto; }
    .track { aspect-ratio: 4 / 3; height: auto; margin-inline: auto; max-height: calc(86svh - 4rem); }
    .artwork { height: 100%; width: 100%; }
    .slide :global(img) { height: 100%; object-fit: cover; width: 100%; }
  }
</style>
